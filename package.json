{
  "name": "milliygo-partner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite --port 7081 --strictPort --host localhost",
    "dev:lan": "vite --port 7081 --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:nsis": "tauri build --bundles nsis",
    "tauri:build:msi": "tauri build --bundles msi",
    "tauri:icons": "tauri icon public/logo.png -o src-tauri/icons",
    "electron:dev": "echo [DEPRECATED] Electron is replaced by Tauri - see TAURI_MIGRATION.md && concurrently \"npm run dev\" \"wait-on http://localhost:7080 && electron .\"",
    "electron:build": "echo [DEPRECATED] Electron is replaced by Tauri - see TAURI_MIGRATION.md && npm run build && node build-desktop.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "axios": "^1.18.0",
    "lucide-react": "^1.20.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^6.30.4",
    "react-yandex-maps": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "react-yandex-maps": {
      "react": "$react"
    },
    "create-react-context": {
      "react": "$react"
    }
  }
}

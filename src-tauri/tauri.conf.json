{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MilliyGo Hamkor",
  "version": "1.0.0",
  "identifier": "uz.milliygo.partner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:7080",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MilliyGo Hamkor",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "additionalBrowserArgs": "--kiosk-printing --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "MilliyGo",
    "category": "Business",
    "shortDescription": "MilliyGo hamkorlar boshqaruv paneli",
    "longDescription": "Restoran va do'konlar uchun buyurtmalar, menyu, smena va statistika boshqaruvi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
